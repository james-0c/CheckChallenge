# microservice specific routes

->          /hmrc-frontend                               hmrcfrontend.Routes

GET         /                                            controllers.IndexController.onPageLoad()

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET         /language/:lang                              controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET         /refresh-session                             controllers.KeepAliveController.keepAlive()

GET         /there-is-a-problem                          controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET         /check-your-answers                          controllers.CheckYourAnswersController.onPageLoad()

GET         /account/sign-out-survey                     controllers.auth.AuthController.signOut()
GET         /account/sign-out                            controllers.auth.AuthController.signOutNoSurvey()
GET         /account/signed-out                          controllers.auth.SignedOutController.onPageLoad()

GET         /unauthorised                                controllers.UnauthorisedController.onPageLoad()

GET         /propertySearch                        controllers.PropertySearchController.onPageLoad(mode: Mode = NormalMode)
POST        /propertySearch                        controllers.PropertySearchController.onSubmit(mode: Mode = NormalMode)
GET         /changePropertySearch                  controllers.PropertySearchController.onPageLoad(mode: Mode = CheckMode)
POST        /changePropertySearch                  controllers.PropertySearchController.onSubmit(mode: Mode = CheckMode)

GET         /addressList                       controllers.AddressListController.onPageLoad()

GET         /searchResults                       controllers.SearchResultsController.onPageLoad(mode: Mode = NormalMode)

GET         /propertyDetails/:localAuthorityRef         controllers.PropertyDetailsController.onPageLoad(localAuthorityRef: String, mode: Mode = NormalMode)

GET        /councilTaxResponsibility                        controllers.CouncilTaxResponsibilityController.onPageLoad(mode: Mode = NormalMode)
POST       /councilTaxResponsibility                        controllers.CouncilTaxResponsibilityController.onSubmit(mode: Mode = NormalMode)
GET        /changeCouncilTaxResponsibility                  controllers.CouncilTaxResponsibilityController.onPageLoad(mode: Mode = CheckMode)
POST       /changeCouncilTaxResponsibility                  controllers.CouncilTaxResponsibilityController.onSubmit(mode: Mode = CheckMode)

GET        /noPermission                       controllers.NoPermissionController.onPageLoad()

POST        /check-your-answers                 controllers.CheckYourAnswersController.onSubmit()

GET         /confirmation                       controllers.ConfirmationController.onPageLoad()

GET        /confirmation                       controllers.ConfirmationController.onPageLoad()
